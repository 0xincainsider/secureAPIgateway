# =============================================================================
# Secure API Gateway - .dockerignore
# =============================================================================
# Excludes non-runtime files from the Docker build context (COPY . .),
# keeping the image small and preventing secrets from being baked in.
# =============================================================================

# Version control
.git
.gitignore
.gitattributes

# Environment files (never bake secrets into images)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg
venv/
.venv/
env/

# Tests and coverage (not needed at runtime)
tests/
.pytest_cache/
.coverage
htmlcov/
test.db

# Documentation and local assets
docs/
.cache/
.codegraph/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/