# =============================================================================
# Secure API Gateway - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
# NEVER commit .env to version control!
# =============================================================================

# --- Application ---
APP_NAME=SecureAPI Gateway
APP_VERSION=1.0.0
APP_DEBUG=false
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_HOSTS=*

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://gateway:gateway_secret@postgres:5432/secure_gateway
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_PER_USER=200
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Prometheus ---
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# --- Security ---
BCRYPT_ROUNDS=12
JWT_ALGORITHM=HS256
JWT_ISSUER=secure-api-gateway
JWT_AUDIENCE=secure-api-gateway-client
ENABLE_RATE_LIMIT=true
ENABLE_SECURITY_HEADERS=true
